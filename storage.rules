rules_version = '2';

// docs/02 §14
service firebase.storage {
  match /b/{bucket}/o {

    function withinSizeLimit() { return request.resource.size < 10 * 1024 * 1024; }
    function isImageOrAudio() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*');
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && withinSizeLimit() && isImageOrAudio();
    }

    match /stores/{storeId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && withinSizeLimit() && isImageOrAudio();
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
