# docs/01-tech-stack-and-architecture.md §4
#
# 이 파일을 .env.local 로 복사해서 실제 값을 채운다. .env.local 은 커밋되지 않는다.
# Vercel 배포 시에는 같은 키를 Project Settings → Environment Variables 에 등록한다.

# ── 클라이언트 노출 O ───────────────────────────────────────────────
# Firebase Web SDK 설정값. NEXT_PUBLIC_FIREBASE_API_KEY 는 비밀값이 아니라 공개 식별자다.
# 실제 보호는 Security Rules + 승인된 도메인 설정으로 한다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── 서버 전용 ──────────────────────────────────────────────────────
# ★ 절대 NEXT_PUBLIC_ 을 붙이지 말 것 (CLAUDE.md §3-1).
#   FIREBASE_PRIVATE_KEY 가 노출되면 전체 DB 가 뚫린다.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=            # 줄바꿈은 \n 으로 이스케이프해 한 줄로 넣는다

# ── 운영 ───────────────────────────────────────────────────────────
# 최초 관리자 지정용 화이트리스트. 콤마 구분 (docs/03 §4.2).
# 운영 배포 후에는 비우는 것을 권장한다.
ADMIN_BOOTSTRAP_EMAILS=

NEXT_PUBLIC_DEFAULT_LOCALE=ko
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 로컬 에뮬레이터를 쓸 때만 true (docs/01 §7)
NEXT_PUBLIC_USE_EMULATOR=false

# ── 개발 도구 전용 (앱 런타임에서는 읽지 않는다) ───────────────────
# scripts/gen-dummy-images.mts (public/dummy 더미 이미지 생성) 에서만 쓴다.
OPENAI_API_KEY=
